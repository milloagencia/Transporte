# Copy to .env and fill in. NEVER commit real values.

# Neon Postgres (use the direct, non-pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Random secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://app.collagetaxi.com"

# SMTP for magic-link and alert emails (Titan mailbox). Leave EMAIL_USER empty in development to log links to the console.
EMAIL_HOST="smtp.titan.email"
EMAIL_PORT="465"
EMAIL_USER="noreply@collagetaxi.com"
EMAIL_PASSWORD=""
EMAIL_FROM="Collage Transport <noreply@collagetaxi.com>"

# Comma-separated emails that become admin when they sign in
ADMIN_EMAIL="you@example.com"

# Solo en desarrollo: "on" carga demos y "off" los elimina; producción siempre los omite.
DEMO_DATA="off"

# Clave privada de Ably (opcional): si falta o falla, las apps consultan por polling.
ABLY_API_KEY=""
# Secreto largo para el cron diario que elimina ubicaciones de más de 30 días.
# Genera uno con: openssl rand -hex 32
LOCATION_CLEANUP_SECRET=""
# Token público de Mapbox (pk.*), solo para mostrar el mapa web.
# Restringe sus URL permitidas al dominio de la app; no habilita rutas/ETA.
# Sin token se muestra la lista de viajes y choferes, sin mapa.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Dirección pública de la API para Expo Go; en pruebas locales usa http://IP_LOCAL_DEL_PC:3000.
# No contiene secretos; no uses la URL de producción hasta que esta versión esté desplegada.
EXPO_PUBLIC_API_URL="https://app.collagetaxi.com"

# Optional: search engine verification codes
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

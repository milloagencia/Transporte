generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  people
  cargo
  mixed
}

enum Exclusivity {
  exclusive
  shared
  either
}

enum SizeClass {
  S
  M
  L
}

enum ColdChain {
  none
  cooler_ice
  active_refrigeration
}

enum OfferStatus {
  active
  paused
  cancelled
  completed
}

enum RequestStatus {
  open
  in_negotiation
  completed
  cancelled
}

enum DealStatus {
  negotiating
  accepted_pending_payment
  paid_escrow
  completed
  cancelled
  disputed
}

enum ProposalStatus {
  pending
  accepted
  countered
  rejected
}

enum PaymentStatus {
  simulated_pending
  simulated_escrow
  simulated_released
  simulated_refunded
}

enum VerificationStatus {
  pending
  approved
  rejected
  expired
}

enum VehicleCategory {
  sedan
  suv
  suv_3row
  minivan
  pickup
  cargo_van
  passenger_van
  box_truck
  trailer
  other
}

enum AccountStatus {
  active
  payment_hold
  suspended
  deleted
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum AccountType {
  individual
  company
}

enum UserRole {
  user
  driver
  admin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  language      String    @default("en")
  role          UserRole  @default(user)
  status          AccountStatus @default(active)
  statusReason    String?
  statusChangedAt DateTime?
  // Onboarding: what the user wants to do and who they are
  accountType     AccountType @default(individual)
  wantsToShip     Boolean     @default(false)
  wantsToDrive    Boolean     @default(false)
  contactName     String?
  phone           String?
  usdotNumber     String?
  onboardedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  driverProfile    DriverProfile?
  tripOffers       TripOffer[]
  tripRequests     TripRequest[]
  dealsAsDriver    Deal[]         @relation("DealDriver")
  dealsAsRequester Deal[]         @relation("DealRequester")
  proposals        Proposal[]
  walletCredits    WalletCredit[]
  vehicles         Vehicle[]
  reviewsWritten   Review[]       @relation("ReviewAuthor")
  reviewsReceived  Review[]       @relation("ReviewSubject")
  adminActions     AdminLog[]
  alerts           TripAlert[]
  mobileSessions   MobileSession[]
  driverLocations  DriverLocation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model DriverProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus VerificationStatus @default(pending)
  licenseNote        String?
  insuranceNote      String?
  inspectionNote     String?
  adminNote          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model TripOffer {
  id                String      @id @default(cuid())
  driverId          String
  driver            User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  originCity        String
  originState       String      @default("NE")
  originZip         String?
  pickupRadiusMiles Float       @default(10)
  /// Driver goes wherever the customer needs (destCity is then empty). maxTripMiles limits how far.
  anyDestination    Boolean     @default(false)
  maxTripMiles      Float?
  destCity          String
  destState         String      @default("NE")
  destZip           String?
  startWindowFrom   DateTime
  startWindowTo     DateTime
  maxDetourMiles    Float       @default(20)
  serviceType       ServiceType
  exclusivity       Exclusivity @default(either)
  seats             Int?
  cargoWeightLbs    Float?
  cargoSizeClass    SizeClass?
  coldChain         ColdChain   @default(none)
  vehicleId         String?
  vehicle           Vehicle?    @relation(fields: [vehicleId], references: [id])
  cargoLengthIn     Float?
  cargoWidthIn      Float?
  cargoHeightIn     Float?
  openTop           Boolean     @default(false)
  proposedRate      Float
  /// "trip" = total price for the trip; "mile" = price per mile (used with anyDestination)
  rateUnit          String      @default("trip")
  isRecurring       Boolean     @default(false)
  recurringDays     String?
  status            OfferStatus @default(active)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deals             Deal[]
}

model TripRequest {
  id                String        @id @default(cuid())
  requesterId       String
  requester         User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  originCity        String
  originState       String        @default("NE")
  originZip         String?
  destCity          String
  destState         String        @default("NE")
  destZip           String?
  windowFrom        DateTime
  windowTo          DateTime
  serviceType       ServiceType
  passengerCount    Int?
  cargoWeightLbs    Float?
  cargoSizeClass    SizeClass?
  cargoDesc         String?
  cargoLengthIn     Float?
  cargoWidthIn      Float?
  cargoHeightIn     Float?
  cargoPieces       Int?
  coldChainRequired ColdChain     @default(none)
  budgetProposed    Float?
  exclusivity       Exclusivity   @default(either)
  status            RequestStatus @default(open)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deals             Deal[]
}

model Deal {
  id              String       @id @default(cuid())
  tripOfferId     String?
  tripOffer       TripOffer?   @relation(fields: [tripOfferId], references: [id])
  tripRequestId   String?
  tripRequest     TripRequest? @relation(fields: [tripRequestId], references: [id])
  driverId        String
  driver          User         @relation("DealDriver", fields: [driverId], references: [id])
  requesterId     String
  requester       User         @relation("DealRequester", fields: [requesterId], references: [id])
  status          DealStatus   @default(negotiating)
  operationalStatus String     @default("accepted")
  exclusivity     Exclusivity  @default(exclusive)
  finalPrice      Float?
  platformFeeRate Float        @default(0.10)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  proposals       Proposal[]
  payment         Payment?
  completion      CompletionConfirmation?
  cancellation    Cancellation?
  reviews         Review[]
  driverLocations DriverLocation[]
}

model MobileAuthRequest {
  id              String    @id @default(cuid())
  codeChallenge   String
  email           String?
  loginAttempts   Int       @default(0)
  codeHash        String?
  codeExpiresAt   DateTime?
  codeUsedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
  @@index([email, createdAt])
}

model MobileSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  role       UserRole
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model DriverLocation {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracyM  Float?
  createdAt  DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([driverId, createdAt])
  @@index([createdAt])
}

model Proposal {
  id           String         @id @default(cuid())
  dealId       String
  deal         Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User           @relation(fields: [proposedById], references: [id])
  price        Float
  message      String?
  status       ProposalStatus @default(pending)
  createdAt    DateTime       @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  dealId      String        @unique
  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  status      PaymentStatus @default(simulated_pending)
  amount      Float
  platformFee Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CompletionConfirmation {
  id                     String    @id @default(cuid())
  dealId                 String    @unique
  deal                   Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  confirmedByDriverAt    DateTime?
  confirmedByRequesterAt DateTime?
  autoReleaseAt          DateTime?
  createdAt              DateTime  @default(now())
}

model Cancellation {
  id            String   @id @default(cuid())
  dealId        String   @unique
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  cancelledById String
  reason        String?
  penaltyRate   Float
  penaltyAmount Float
  creditIssued  Float    @default(0)
  createdAt     DateTime @default(now())
}

model WalletCredit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Reference catalog: typical capacity per make/model (approximate values, editable by the driver)
model VehicleModel {
  id            String          @id @default(cuid())
  make          String
  model         String
  variant       String          @default("")
  category      VehicleCategory
  seats         Int
  cargoLengthIn Float
  cargoWidthIn  Float
  cargoHeightIn Float?
  openTop       Boolean         @default(false)
  payloadLbs    Float
  note          String?
  vehicles      Vehicle[]

  @@unique([make, model, variant])
}

/// A driver's own vehicle (values copied from the catalog and adjustable)
model Vehicle {
  id             String          @id @default(cuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleModelId String?
  vehicleModel   VehicleModel?   @relation(fields: [vehicleModelId], references: [id])
  make           String
  model          String
  year           Int?
  /// License plate. Private: shown only to the owner, admin and the other side of a paid deal.
  plateNumber    String?
  plateState     String?
  color          String?
  category       VehicleCategory
  seats          Int
  cargoLengthIn  Float
  cargoWidthIn   Float
  cargoHeightIn  Float?
  openTop        Boolean         @default(false)
  payloadLbs     Float
  coldChain      ColdChain       @default(none)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tripOffers     TripOffer[]
}

/// Rating + optional comment left after a completed deal.
/// Stars count once the review is revealed (both sides reviewed, or 14 days passed).
/// Comments are public only after an admin approves them. Admin can hide a whole review.
model Review {
  id             String       @id @default(cuid())
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        User         @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  authorRole     String
  stars          Int
  comment        String?
  commentStatus  ReviewStatus @default(pending)
  hidden         Boolean      @default(false)
  moderationNote String?
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([dealId, authorId])
  @@index([subjectId])
}

/// Audit trail of admin actions.
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Saved search: email the user when a matching offer (kind=offers) or request (kind=requests) is posted.
model TripAlert {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             String
  requestId        String?
  vehicleId        String?
  originCity       String?
  originState      String?
  destCity         String?
  destState        String?
  radiusMiles      Int          @default(25)
  dateFrom         DateTime?
  dateTo           DateTime?
  serviceType      String?
  passengers       Int?
  cargoWeightLbs   Float?
  cargoLengthIn    Float?
  cargoWidthIn     Float?
  cargoHeightIn    Float?
  coldChain        ColdChain    @default(none)
  active           Boolean      @default(true)
  lastNotifiedAt   DateTime?
  matchesSent      Int          @default(0)
  unsubscribeToken String       @unique @default(cuid())
  createdAt        DateTime     @default(now())

  @@index([kind, active])
}

/// Messages sent from the public contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  lang      String   @default("es")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

# Copy to .env and fill in. NEVER commit real values.

# Neon Postgres (use the direct, non-pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Random secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://app.collagetaxi.com"

# SMTP for magic-link and alert emails (Titan mailbox). Leave EMAIL_USER empty in development to log links to the console.
EMAIL_HOST="smtp.titan.email"
EMAIL_PORT="465"
EMAIL_USER="noreply@collagetaxi.com"
EMAIL_PASSWORD=""
EMAIL_FROM="Collage Transport <noreply@collagetaxi.com>"

# Comma-separated emails that become admin when they sign in
ADMIN_EMAIL="you@example.com"

# "on" = load demo users/trips on every build; anything else removes them
DEMO_DATA="off"

# Optional: search engine verification codes
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""
